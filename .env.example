# Telegram
BOT_TOKEN=123456:ABCDEF
ADMIN_IDS=7028523300,6120166351
WEBSITE=https://socialmarkhors.me
CREDIT=Config by Social Markhors

# behaviour
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
MAX_FILES=15000
POST_MIN=45
POST_MAX=110

# Supabase (service_role key - root password ki tarah treat karein)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
# alag tables banengi: fb_accounts, ig_accounts

# Proxies (sirf X/FB/IG traffic; Telegram + Supabase direct)
PROXIES=
PROXY_TYPE=socks5
PROXY_MODE=rotate
PROXY_TEST_URL=https://graph.facebook.com/me

# Health check
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_HOST=0.0.0.0

# Encryption key for cookie storage at rest
ENCRYPTION_KEY=

# User state TTL (minutes)
USER_STATE_TTL_MIN=30

# Per-user command rate limiting (seconds between commands)
USER_CMD_COOLDOWN=2.0

# Zip bomb protection
ZIP_MAX_TOTAL=268435456
ZIP_MAX_FILE=16777216
