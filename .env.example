# Telegram
BOT_TOKEN=123456:ABCDEF
ADMIN_IDS=7028523300,6120166351

# Branding (reworked cookie header + campaign post footer)
BRAND=Evil Markhors
WEBSITE=https://evilmarkhors.me, https://evilmarkhors.tech
CREDIT=Config by Evil Markhors
WHATSAPP_URL=https://whatsapp.com/channel/0029Vb5qjwcG8l5CaqjMSU0K
TELEGRAM_URL=https://t.me/+IGM63Xe1A-43ZTdk
TWITTER_URL=https://x.com/EvilMarkhors
FACEBOOK_URL=https://www.facebook.com/share/19FyzDCNe6/
DEFAULT_TAG=#EvilMarkhors
POST_BRANDING=1

# behaviour
CONCURRENCY=8
TIMEOUT=25
ACC_TIMEOUT=90
RETRIES=3
MAX_FILES=15000
POST_MIN=45
POST_MAX=110

# Supabase (service_role key - root password ki tarah treat karein)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=service_role_key
# alag tables banengi: fb_accounts, ig_accounts

# Proxies (sirf FB/IG traffic; Telegram + Supabase direct)
PROXIES=
PROXY_TYPE=socks5
# rotate = random per request | first/single/sticky = pehla proxy
PROXY_MODE=rotate
PROXY_TEST_URL=https://graph.facebook.com/me

# Health check (Railway PORT auto-detect hota hai; ye manually override karta hai)
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_HOST=0.0.0.0

# Startup par FB/IG/Supabase reachability check
NETCHECK_ON_START=1

# Encryption key for cookie storage at rest
ENCRYPTION_KEY=

# User state TTL (minutes)
USER_STATE_TTL_MIN=30
# In-memory state entries ka hard cap (TTL ke andar bhi memory bounded rahe)
MAX_STATE_ENTRIES=5000

# Campaign text variants ka max count per campaign
MAX_TEXT_VARIANTS=20

# Per-user command rate limiting (seconds between commands)
USER_CMD_COOLDOWN=2.0

# Text/media/zip ingestion flood protection (commands se alag; 0 = band)
CONTENT_COOLDOWN=0.5

# Ek cookie file ka max processing time (seconds). Timeout par file errors/ me
# jati hai aur processing aage barhti hai.
FILE_TIMEOUT=180

# Instagram Graph media container polling (publish se pehle ready hone ka wait)
IG_MEDIA_POLLS=10
IG_MEDIA_POLL_SEC=2

# Zip bomb protection
ZIP_MAX_TOTAL=268435456
ZIP_MAX_FILE=16777216

# Verification fallback: agar proxy + direct dono fail hon to itne seconds
# baad ek aur direct retry hoti hai (0 = band)
VERIFY_SLOW_RETRY_SEC=5

# Live progress updates ka interval (seconds) - Telegram edit flood se bachne ke liye
PROGRESS_UPDATE_SEC=3

# Proxy se DEAD aaye to direct Railway IP se confirm karna (1 = haan, 0 = nahi)
VERIFY_CONFIRM_DEAD=1
